class Movies:
    def __init__(self):
        self.movies = []
    
    def add_movie(self, movie):
        self.movies.append(movie)

class Comedy(Movies):
    def add_movie(self, movie):
        super().add_movie(movie)
        return f"Комедии: {self.movies}"

class Drama(Movies):
    def add_movie(self, movie):
        super().add_movie(movie)
        return f"Драмы: {self.movies}"       

comedy = Comedy()
add_comedy = comedy.add_movie('Большой кабинет управления шаблона куш')
print(add_comedy)

drama = Drama()
add_drama = drama.add_movie('Большой кабинет управления шаблона куш')
print(add_drama)
